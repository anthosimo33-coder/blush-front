{
  "name": "front",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/developper.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "galerie": "node scripts/galerie/capture.mjs",
    "fluidite": "node scripts/galerie/capture.mjs --fluidite",
    "predev": "node scripts/prompts.mjs",
    "prebuild": "node scripts/prompts.mjs && node scripts/verifier-migrations.mjs",
    "postbuild": "node scripts/verifier-fuite.mjs && node scripts/migrer.mjs",
    "pretest": "node scripts/prompts.mjs && node scripts/verifier-migrations.mjs",
    "test": "vitest run",
    "test:unit": "node scripts/prompts.mjs && vitest run --project unit --project client",
    "check": "node scripts/prompts.mjs && node scripts/verifier-migrations.mjs && next typegen && tsc --noEmit && eslint . --max-warnings 0 && prettier --check . && node scripts/verifier-typo.mjs && npm run mort && vitest run --coverage",
    "mort": "knip --no-progress",
    "couverture": "node scripts/prompts.mjs && vitest run --coverage",
    "forme": "prettier --check .",
    "forme:ecrire": "prettier --write .",
    "todo": "git grep -n -e 'TODO(produit)' -e 'test\\.fixme(' -- src scripts tests || true",
    "e2e:build": "node tests/e2e/construire.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:visuel": ": \"${E2E_VISUEL_DIR:?le dossier des captures de référence, hors du dépôt (voir tests/e2e/visuel.spec.ts)}\" && playwright test --project=visuel-chromium --project=visuel-webkit",
    "db:generer": "drizzle-kit generate",
    "db:migrer": "node scripts/migrer.mjs --ici",
    "acces": "tsx --conditions=react-server scripts/acces.mts",
    "charge": "tsx scripts/charge.mjs",
    "essai:vrai-modele": "tsx --conditions=react-server scripts/essai-vrai-modele.mts",
    "essai:memoire": "tsx --conditions=react-server scripts/essai-memoire.mts",
    "essai:memoire-groupee": "tsx --conditions=react-server scripts/essai-memoire-groupee.mts",
    "essai:ajouts": "tsx --conditions=react-server scripts/essai-ajouts.mts",
    "essai:captures": "tsx --conditions=react-server scripts/essai-captures.mts",
    "essai:video": "tsx --conditions=react-server scripts/essai-video-modeles.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@react-pdf/renderer": "4.8.0",
    "@whop/elements": "1.9.0",
    "@whop/elements-react": "1.9.0",
    "client-only": "0.0.1",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "posthog-js": "1.435.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "happy-dom": "^20.14.6",
    "knip": "6.38.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
