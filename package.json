{
  "name": "front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/developper.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "galerie": "node scripts/galerie/capture.mjs",
    "fluidite": "node scripts/fluidite/fluidite.mjs",
    "predev": "node scripts/prompts.mjs",
    "prebuild": "node scripts/prompts.mjs && node scripts/verifier-migrations.mjs && node scripts/migrer.mjs",
    "postbuild": "node scripts/verifier-fuite.mjs",
    "pretest": "node scripts/prompts.mjs && node scripts/verifier-migrations.mjs",
    "test": "vitest run",
    "check": "node scripts/prompts.mjs && node scripts/verifier-migrations.mjs && next typegen && tsc --noEmit && eslint . && vitest run",
    "e2e:build": "node tests/e2e/construire.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:visuel": ": \"${E2E_VISUEL_DIR:?le dossier des captures de référence, hors du dépôt (voir tests/e2e/visuel.spec.ts)}\" && playwright test --project=visuel-chromium --project=visuel-webkit",
    "db:generer": "drizzle-kit generate",
    "db:migrer": "drizzle-kit migrate",
    "acces": "tsx scripts/acces.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
