# BLUSH en local, avec son back-end : copie ce fichier (cp .env.example .env.development.local), puis npm run dev.
# Seul `next dev` lit .env.development.local : ni le build (npm run build, npm run e2e:build) ni les tests ne le voient.
# Tout est fictif ici : aucune vraie clé, jamais la clé ni la base de la production.

# La base Postgres de ce poste (Homebrew : brew services start postgresql@16). npm run dev la crée si elle manque, puis la migre.
DATABASE_URL=postgres://localhost:5432/blush_dev

# La clé de chiffrement du contenu, 32 octets en base64. Celle-ci est une clé de dev, fictive et connue de tous :
# une autre se tire avec openssl rand -base64 32.
BLUSH_CLE=Y2xlLWZpY3RpdmUtZHUtZGV2LWxvY2FsLWJsdXNoISE=

# Le modèle factice : il rejoue des sorties enregistrées, aucun appel payé. Avec lui, npm run dev refuse les clés d’API
# (Anthropic, Resend, Mistral, ElevenLabs). Sans Resend, le code de connexion s’affiche dans le terminal.
BLUSH_IA_FACTICE=1

# Bêta sans paiement : tout le monde a BLUSH+ d’office (« * »), ou une liste d’emails séparés par des virgules.
BLUSH_ACCES_LIBRE=*

# Bêta fermée : seuls les emails de BLUSH_ACCES_LIBRE peuvent se connecter.
# BLUSH_BETA_FERMEE=1
