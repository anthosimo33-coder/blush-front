# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# les tests de bout en bout : résultats, traces, rapports, boîte à mails (npm run e2e)
/test-results/
/playwright-report*/
/blob-report/
/playwright/.cache/
# le build des tests de bout en bout empaqueté par la CI : il contient les prompts, côté serveur
/build-e2e.tar
# la CLI Vercel de la mise en production (npm ci --prefix scripts/deployer)
/scripts/deployer/node_modules/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# galerie des écrans (générée)
/.galerie/

# Les textes des prompts, générés depuis le sous-module (scripts/prompts.mjs)
/src/server/ia/textes.generated.ts
